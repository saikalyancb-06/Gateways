# ==============================================================================
# ResearchOps Core - .gitignore
# ==============================================================================

# Secrets & Environment variables
.env
.env.*
!.env.example
*.pem
*.key
*.cert
secrets.json

# Python
__pycache__/
*.py[cod]
*.pyd
*.so
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Frontend
node_modules/
dist/
build/
.cache/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*

# Databases & local storage
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm

# Logs & temp files
logs/
*.log
*.tmp
*.temp
scratch/

# OS / IDE
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/settings.json
